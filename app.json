{
  "expo": {
    "name": "619 - Discipline Daily",
    "slug": "619",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/619_logo.png",
    "scheme": "sixnineteen",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/619_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#040D0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sixnineteen.app",
      "icon": "./assets/images/619_logo.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sixnineteen.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/619_logo.png",
        "backgroundColor": "#040D0A"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/619_logo.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/619_logo.png",
          "color": "#10B981"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "619 needs access to your photos to update your profile picture.",
          "cameraPermission": "619 needs camera access to take a profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a93b436-80e2-45c6-8c1e-4ebfe6a154d6"
      }
    }
  }
}
